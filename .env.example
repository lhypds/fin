PORT=3015
PM2_NAME=fin

# Where uploads (uploads/<unix ms>/) and the reconciliation state (state.json) are stored. Relative to the project root.
# DATA_DIR=data

# Server-side only, used for OCR. Never sent to the browser.
OPENAI_API_KEY=

# Optional. Use this for Azure/OpenAI-compatible gateways.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Any vision model that supports Structured Outputs and PDF input. Read at startup, no rebuild needed.
# Examples: gpt-5.4-mini (default), gpt-5.4, gpt-4.1-mini
# OPENAI_MODEL=gpt-5.4-mini
